# ============================================================
#  Environment Variables — Portfolio
#  ------------------------------------------------------------
#  Salin file ini menjadi `.env.local` lalu sesuaikan nilainya.
#  SEMUA variabel di bawah BERSIFAT OPSIONAL — aplikasi langsung
#  berjalan dengan database lokal tanpa mengisi apa pun.
# ============================================================

# Database (libSQL / Turso)
# Kosongkan untuk memakai file lokal `data/portfolio.db`.
# Untuk production, buat database di https://turso.tech lalu isi:
DATABASE_URL=libsql://your-db-org.turso.io
# (atau pakai nama variabel dari dashboard Turso:)
# TURSO_DATABASE_URL=libsql://your-db-org.turso.io

# Token autentikasi — hanya dibutuhkan untuk Turso cloud
DATABASE_AUTH_TOKEN=
# TURSO_AUTH_TOKEN=

# Token admin untuk melihat daftar pesan kontak via GET /api/contact
# (Authorization: Bearer <token>). Kosongkan untuk menonaktifkan.
ADMIN_TOKEN=
